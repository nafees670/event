# Copy to .env and adjust. Every setting the app reads is listed here.
# After changing .env, recreate the containers: docker compose up -d --force-recreate

# --- Django ---------------------------------------------------------------
# Required in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Optional separate key for JWT signing (defaults to SECRET_KEY)
JWT_SIGNING_KEY=
TIME_ZONE=UTC
LOG_LEVEL=INFO
# Number of reverse proxies in front of Django (Nginx = 1). Used for client IPs in rate limits.
TRUSTED_PROXY_COUNT=1

# Public URL of the app, used in emailed links (invites, password reset)
FRONTEND_URL=http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost
# Only needed when running the Next.js dev server on its own port without Nginx
CORS_ALLOWED_ORIGINS=

# --- Auth ------------------------------------------------------------------
# Absolute session length; refresh rotation never extends past this
SESSION_MAX_HOURS=12
ACCESS_TOKEN_MINUTES=15
# Keep True anywhere served over HTTPS. Browsers accept Secure cookies on http://localhost.
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
EMAIL_VERIFICATION_CODE_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
INVITATION_EXPIRY_HOURS=72
PASSWORD_RESET_TIMEOUT_SECONDS=3600

# Rate limits (DRF format: <n>/<sec|min|hour|day>)
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/min
THROTTLE_VERIFY=10/min
THROTTLE_PASSWORD_RESET=5/min

# --- Database ----------------------------------------------------------------
# NOTE: Postgres only applies POSTGRES_PASSWORD when its volume is first created.
# Changing it later needs `docker compose down -v` (wipes data) or ALTER USER.
POSTGRES_DB=pm_suite
POSTGRES_USER=pm_suite
POSTGRES_PASSWORD=pm_suite_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# --- Email ---------------------------------------------------------------------
# The console backend prints emails (verification codes, invites) in the celery logs.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=PM Suite <no-reply@pm-suite.local>

# --- Files -----------------------------------------------------------------
MEDIA_ROOT=/app/media
PRIVATE_STORAGE_ROOT=/data/private
# Largest task attachment, in MB (Nginx allows up to 50)
MAX_ATTACHMENT_MB=25

# --- Analytics -------------------------------------------------------------------
# Open tasks per person that count as a full (100%) workload
WORKLOAD_CAPACITY=8

# --- Production only ---------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
ALLOW_SEED=False

# --- Frontend (Next.js) ----------------------------------------------------------
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=30
# Where `next dev` proxies /api when run without Nginx
BACKEND_URL=http://localhost:8000

# --- Docker Compose ------------------------------------------------------------
HTTP_PORT=80
# Host port for direct backend access (used by `next dev` without Nginx)
BACKEND_PORT=8000
